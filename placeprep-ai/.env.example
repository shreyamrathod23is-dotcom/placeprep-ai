# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# One or more ":free" models from https://openrouter.ai/models (free model names change over time).
# Comma-separated: later models are used as fallbacks on rate limits / malformed JSON.
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free,google/gemma-3-27b-it:free
